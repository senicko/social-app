{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "pnpm install --frozen-lockfile && pnpm --dir dev-env install --frozen-lockfile && bash .cursor/cloud/build-argent.sh",
  "start": "bash .cursor/cloud/start.sh",
  "terminals": [
    {
      "name": "metro",
      "command": "PATH=/usr/bin:$PATH EXPO_NO_TELEMETRY=1 node_modules/expo/bin/cli start --dev-client --port 8081 2>&1 | tee .cursor/cloud/metro.log"
    }
  ]
}
